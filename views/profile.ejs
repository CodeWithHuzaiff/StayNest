<% layout('layouts/boilerplate') %>

<div class="profile-page">
  <div class="profile-card">

    <div class="profile-avatar">
      👤
    </div>

    <p class="name">
      <%= currentUser ? currentUser.username : "Guest User" %>
    </p>
    <div class="profile-info">
      <div class="info-row">
        <span>Email</span>
        <p><%= currentUser ? currentUser.email : "--" %></p>
      </div>

      <div class="info-row">
        <span>Phone</span>
        <p><%= user && user.phone ? user.phone : "--" %></p>
      </div>

      <div class="info-row">
        <span>Location</span>
        <p><%= user && user.location ? user.location : "--unknown--" %></p>
      </div>
    </div>

    <div class="profile-actions">
      <a href="/listings" class="btn-secondary">View Listings</a>
      <% if (user) { %>
        <a href="/profile/edit/<%= user._id %>" class="btn-primary">Edit Profile</a>
      <% } %>
    </div>

  </div>
</div>