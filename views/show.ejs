<% layout('layouts/boilerplate') %>



<section class="lux-show">
  <div class="lux-container">
    <!-- LEFT: LISTING EXPERIENCE -->
    <div class="lux-listing">
      <div class="lux-image-wrap">
        <img src="<%= attach.image.url %>" alt="Listing image" />
      </div>

      <div class="lux-content">
        <h1 class="lux-title"><%= attach.title %></h1>

        <div class="lux-author">
          Hosted by <strong><%= attach.author.username %></strong>
        </div>

        <p class="lux-description"><%= attach.description %></p>

        <div class="lux-location">
          📍 <%= attach.location %>, <%= attach.country %>
        </div>
      </div>

      <!-- Sticky Action Bar -->
      <div class="lux-sticky-bar">
        <div class="lux-sticky-price">
          ₹ <%= attach.price.toLocaleString("en-IN") %>
          <span>/ night</span>
        </div>

        <div class="lux-sticky-actions">
          <form method="get" action="/listings/<%= attach._id %>/edit">
            <button class="lux-btn lux-primary">Edit</button>
          </form>

          <form
            method="post"
            action="/listings/<%= attach._id %>?_method=DELETE"
          >
            <button class="lux-btn lux-danger">Delete</button>
          </form>

          <form method="get" action="/listings">
            <button class="lux-btn lux-neutral">Back</button>
          </form>
        </div>
      </div>
    </div>

    <!-- RIGHT: REVIEWS PANEL -->
    <aside class="lux-reviews">
      <div class="lux-review-shell">
        <% if (currentUser) { %>
        <h2 class="lux-review-title">Leave a Review</h2>

        <form
          method="post"
          action="/listings/<%= attach._id %>/review"
          class="lux-form"
        >
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
            />
            <input type="radio" id="rate1" name="review[rating]" value="1" />
            <label for="rate1">1</label>
            <input type="radio" id="rate2" name="review[rating]" value="2" />
            <label for="rate2">2</label>
            <input type="radio" id="rate3" name="review[rating]" value="3" />
            <label for="rate3">3</label>
            <input type="radio" id="rate4" name="review[rating]" value="4" />
            <label for="rate4">4</label>
            <input type="radio" id="rate5" name="review[rating]" value="5" />
            <label for="rate5">5</label>
          </fieldset>

          <textarea
            name="review[comment]"
            placeholder="Share your experience..."
            required
          ></textarea>

          <button class="lux-submit">Submit</button>
        </form>
        <% } %>

        <h2 class="lux-review-title">Reviews</h2>

        <div class="lux-review-list">
          <% if (!attach.reviews || attach.reviews.length === 0) { %>
          <p class="lux-empty">No reviews yet.</p>
          <% } else { %> <% for(review of attach.reviews){ %>
          <div class="lux-review-item">
            <strong><%= review.author.username %></strong>
            <p
              class="starability-result"
              data-rating="<%= review.rating %>"
            ></p>
            <p><%= review.comment %></p>

            <form
              method="post"
              action="/listings/<%= attach._id %>/review/<%= review._id %>?_method=DELETE"
            >
              <button class="lux-delete-mini">Delete</button>
            </form>
          </div>
          <% } %> <% } %>
        </div>
      </div>
    </aside>
  </div>

  <!-- MAP -->
  <section class="lux-map">
    <h2>Where You'll Be</h2>
    <div 
    id="map"
    data-token="<%= process.env.MAP_TOKEN %>"
    data-listing='<%- JSON.stringify(attach) %>'>
  </div>
  </section>
</section>

<script src="/js/map.js"></script>
