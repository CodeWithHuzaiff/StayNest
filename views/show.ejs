<% layout('layouts/boilerplate') %>

<div class="show-page">
  <div class="listing-card">
    <img src="<%= attach.image.url %>" alt="Listing image" />

    <div class="card-content">
      <h2><%= attach.title %></h2>
      <p><b>Author :</b><i><%= attach.author.username %></i></p>

      <p><%= attach.description %></p>

      <div class="meta">📍 <%= attach.location %>, <%= attach.country %></div>

      <div class="price">
        ₹ <%= attach.price.toLocaleString("en-IN") %> / night
      </div>

      <div class="actions">
        <form method="get" action="/listings/<%= attach._id %>/edit">
          <button class="edit-btn">Edit</button>
        </form>

        <form method="post" action="/listings/<%= attach._id %>?_method=DELETE">
          <button class="delete-btn">Delete</button>
        </form>

        <form method="get" action="/listings">
          <button class="back-btn">Back</button>
        </form>
      </div>
    </div>

    <div class="review col-8 offset-1">
      <% if (currentUser) { %>

      <h4>Leave a Review</h4>
      <hr />
      <form
        method="post"
        action="/listings/<%= attach._id %>/review"
        novalidate
        class="needs-validation"
      >
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">comment</label>
          <textarea
            name="review[comment]"
            class="form-control"
            id="comment"
            cols="40"
            rows="5"
            required
          ></textarea>
          <div class="invalid-feedback">Comment is required!</div>
          <div class="valid-feedback">Looks good!</div>
        </div>
        <button class="btn btn-outline-dark mb-3">Submit</button>
      </form>
      <hr />
      <% } %>
      <h4>All Ratings</h4>
      <% if (!attach.reviews || attach.reviews.length === 0) { %>
      <h3>---No Review Yet---</h3>
      <% }else{%> <% for(review of attach.reviews){%>
      <div class="card mb-3" style="width: 25rem">
        <div class="card-body">
          <h5 class="card-title">
            Commented By:<b><%= review.author.username %></b>
          </h5>
          <p 
            class="starability-result card-text" data-rating=<%= review.rating%> Rated: <%= review.rating%> stars>
          </p>
          <p class="card-text"><%= review.comment %></p>

          <form
            class=""
            method="post"
            action="/listings/<%= attach._id %>/review/<%= review._id %>?_method=DELETE"
          >
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
      </div>
      <% } %> <% } %>
    </div>
  </div>
</div>
